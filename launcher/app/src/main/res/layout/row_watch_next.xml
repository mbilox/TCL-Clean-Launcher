<?xml version="1.0" encoding="utf-8"?>
<!--
  The Continue watching row: one full-width item of the app grid holding the content cards sideways, so the
  owner can reach up to WATCH_NEXT_MAX_ITEMS cards instead of the one grid row the band used to show. The
  cards themselves are item_app.xml at tile size, drawn by the row's own adapter.
-->
<androidx.recyclerview.widget.RecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/watchRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:descendantFocusability="afterDescendants"
    android:overScrollMode="never" />
